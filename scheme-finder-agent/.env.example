# ──────────────────────────────────────────────────────────────────────────────
# Scheme Finder Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# LLM Provider: choose one of  openai | gemini | anthropic | groq
LLM_PROVIDER=groq

# Your API key for the chosen provider
LLM_API_KEY=your_api_key_here

# Model to use for the chosen provider.
# These are the recommended defaults — change only if you know what you want.
#
# For Groq, to see all models available on your account:
#   python -c "from groq import Groq; import os; from dotenv import load_dotenv; load_dotenv(); [print(m.id) for m in Groq(api_key=os.getenv('LLM_API_KEY')).models.list().data]"

# OpenAI default
# LLM_MODEL=gpt-4o-mini

# Gemini default
# LLM_MODEL=gemini-1.5-flash

# Anthropic default
# LLM_MODEL=claude-3-haiku-20240307

# Groq default — benchmarked best on this project (3/3 correct, ~0.18s)
LLM_MODEL=qwen/qwen3.8-27b
