# ──────────────────────────────────────────────────────────────────────────────
# Scheme Finder Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# LLM Provider: choose one of  openai | gemini | anthropic | groq
LLM_PROVIDER=openai

# Your API key for the chosen provider
LLM_API_KEY=your_api_key_here

# (Optional) Override the default model for the chosen provider
# OpenAI default:    gpt-4o-mini
# Gemini default:    gemini-1.5-flash
# Anthropic default: claude-3-haiku-20240307
# Groq default:      llama3-8b-8192
# LLM_MODEL=llama3-8b-8192
